# Wi-Fi station (AP credentials to join)
SSID=your_ssid
PASS=your_pass

# Motion theme:
#   classic  - All-red K.I.T.T. scanner & motion map (states differ by motion only)
#   colorful - Vivid color-coded theme (distinct vivid colors & motions per state)
MOTION_THEME=classic

# MQTT broker (Home Assistant Mosquitto etc.)
MQTT_BROKER=homeassistant.local
MQTT_PORT=1883
MQTT_USER=mqtt_user
MQTT_PASS=
MQTT_TOPIC_PREFIX=kitt-eye
MQTT_CLIENT_ID=kitt-eye-mcu
